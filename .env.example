# --- Runtime ---
# "production" refuses to start with default secrets (fail closed).
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated CORS origins for browser clients (empty = none).
CORS_ORIGINS=
# Abuse protection.
# Reject request bodies larger than this many bytes (0 = no limit).
MAX_REQUEST_BYTES=1000000
# Per-client requests per minute, keyed by IP / X-Forwarded-For (0 = disabled).
RATE_LIMIT_PER_MINUTE=600
# Trust X-Forwarded-For for the client IP. Only enable behind a trusted proxy.
TRUST_FORWARDED_FOR=false

# --- Identity ---
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256

# Verification mode (plug-and-play; no code change to switch):
#   jwt_claims = trust HS256 token claims        (dev / simple)
#   delegation = verify an Ed25519-signed grant  (production; scope is authoritative)
IDENTITY_MODE=jwt_claims
# For delegation mode: PEM text or path to the issuer's Ed25519 public key.
# Mint keys/tokens with:  agentplane identity keygen --out-dir keys
DELEGATION_PUBLIC_KEY=
# Optional expected `iss` / `aud` on a verified delegation.
DELEGATION_ISSUER=
DELEGATION_AUDIENCE=
# Kill switch: comma-separated revoked delegation jti values, and/or a file
# holding one revoked jti per line.
REVOKED_JTIS=
REVOCATION_FILE=
# Agent-to-agent (A2A) delegation: the Ed25519 PRIVATE key the control plane uses to
# mint scoped child credentials (pairs with DELEGATION_PUBLIC_KEY). Unset = A2A disabled.
DELEGATION_SIGNING_KEY=
# Cap on the lifetime of a minted child credential.
MAX_DELEGATION_TTL_SECONDS=3600

# --- Audit tamper-evidence ---
# HMAC key over the hash-chained decision record (also signs approval webhooks).
AUDIT_SIGNING_KEY=dev-audit-key-change-me

# --- Storage backend ---
# local    = SQLite audit + in-memory cache/quota (zero setup, default)
# postgres = Postgres audit + Redis cache/quota (docker-compose profile)
STORAGE_BACKEND=local
# Where leases, use counters, approvals, and the gateway request ledger live:
#   sql    = the audit database above; durable, shared by every replica (default)
#   memory = process-local; single worker only, refused in production
AUTHORITY_STORE=sql
# For Docker, override with /data/audit.db and mount a named volume at /data.
# Accounts, projects, API keys, and rules live in this same database.
SQLITE_PATH=audit.db
POSTGRES_URL=postgresql+psycopg://agentplane:agentplane@localhost:5432/agentplane
REDIS_URL=redis://localhost:6379/0

# --- Policy ---
# Directory of policy YAML evaluated on every decision.
POLICY_DIR=policies

# --- Model catalog (config-driven) ---
# YAML model/provider catalog. Unset -> config/models.yaml if present, else built-ins.
MODELS_FILE=

# --- Tool catalog (config-driven; the agent->tool broker edge) ---
# YAML tool catalog. Unset -> config/tools.yaml if present, else no tools (default-deny).
TOOLS_FILE=

# Optional MCP gateway: operator mappings and agent/task bindings.
# Install agent-plane[mcp]; generate a starting file with `agentplane mcp discover`.
MCP_GATEWAY_FILE=

# --- Authority leases ---
# YAML lease catalog and lease templates. Unset -> config/leases.yaml and
# config/lease-templates.yaml if present, else the packaged defaults.
LEASES_FILE=
LEASE_TEMPLATES_FILE=
# Starter ALLOW / ASK FIRST / NEVER rule sets offered in the console's Rules
# screen. Unset -> config/rule-templates.yaml if present, else the packaged
# defaults. Templates are only ever offered, never applied automatically.
RULE_TEMPLATES_FILE=

# --- Approvals (human in the loop) ---
# Pending approvals expire after this many seconds (never later than the lease).
APPROVAL_TTL_SECONDS=3600
# Optional webhook for signed approval.requested/approved/rejected events
# (HMAC-SHA256 with AUDIT_SIGNING_KEY in X-AgentPlane-Signature).
APPROVAL_WEBHOOK_URL=

# --- Consequence catalog ---
# YAML resource + action profiles that turn an action into a consequence.
# Unset -> config/resources.yaml if present, else the packaged defaults.
RESOURCES_FILE=

# --- Observe -> Govern -> Enforce ---
# observe = nothing is blocked; a would-be DENY/REVIEW comes back as SIMULATE
#           with `would_be`, and the registry records what the agent tried.
# govern  = the real decision is returned and violations are flagged, but
#           `enforced` is false so an executor may still proceed.
# enforce = DENY / APPROVAL / QUARANTINE bind where agent-plane is the
#           execution chokepoint.
# A project carries its own mode and always wins. This is only the fallback for
# traffic that belongs to no project (a legacy JWT tenant), so upgrading never
# silently stops enforcing. New projects created through onboarding start in
# "observe" regardless of this value. Per-tenant override: PUT /admin/mode.
ENFORCEMENT_MODE=enforce

# --- Accounts, API keys, and console sessions ---
# Key used to derive the stored HMAC of every API key (ap_live_/ap_test_/ap_mgmt_)
# and to sign the httponly console session cookie. Unset -> falls back to
# JWT_SECRET so a dev install needs no extra setup; set it explicitly in
# production. Rotating it invalidates every issued API key and signs everyone out.
API_KEY_SECRET_VALUE=
# first_user = the first person to sign up becomes the owner, then signup closes
# open       = anyone may sign up
# closed     = nobody may sign up (invite/seed accounts only)
SIGNUP_MODE=first_user
# Console session cookie lifetime (default 14 days).
SESSION_TTL_SECONDS=1209600
# Send the session cookie only over HTTPS. Forced on when ENVIRONMENT=production.
SECURE_COOKIES=false

# --- Single sign-on (OIDC, optional) ---
# For the console only: humans sign in with their identity provider instead of
# a password. Agents are unaffected - they authenticate with a Project API Key,
# so a provider outage can never stop them being governed. Leaving OIDC_ISSUER
# empty turns the whole feature off, including its two routes.
# Any OpenID Connect provider works; the issuer's discovery document supplies
# the endpoints, so Auth0, Okta, Google, Entra and Keycloak are the same three
# settings. Register the callback with the provider:
#   https://<your-host>/v1/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only needed behind a proxy, where the request's own host is not the public
# one. Must match what you registered with the provider.
OIDC_REDIRECT_URL=
# Restrict sign-in to these email domains (comma separated). Empty allows any
# domain the provider vouches for.
OIDC_ALLOWED_DOMAINS=
# Turn off password sign-in once SSO works. Ignored while SSO is unconfigured,
# so a typo in the issuer cannot lock everyone out.
OIDC_ONLY=false

# --- Hosted demo ---
# Enables /demo/* and lets the console read the isolated "demo" tenant with
# X-Demo-Token. Disable on production deployments that are not the hosted demo.
DEMO_ENABLED=true
DEMO_TOKEN=demo

# --- Observability ---
# text or json (one JSON object per line).
LOG_FORMAT=text
# Prometheus text at /metrics (unauthenticated; restrict at the edge).
METRICS_ENABLED=true

# --- Knowledge sources (config-driven; the RAG authorization edge) ---
# YAML sources + documents with access metadata. Unset -> config/knowledge.yaml.
KNOWLEDGE_FILE=

# --- Admin API (live revocation + policy hot-reload) ---
# Unset = disabled. Set a strong token to enable; pass it in X-Admin-Token.
ADMIN_TOKEN=

# --- Usage metering (foundation for usage-based billing) ---
USAGE_METERING=true
# Optional price book; unset -> config/pricing.yaml if present. Metering, not billing.
PRICING_FILE=

# --- Providers (real calls; set at least one) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

AZURE_OPENAI_API_KEY=
# e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01

# --- Quotas (tokens per rolling window) ---
DEFAULT_TOKEN_QUOTA=100000
QUOTA_WINDOW_SECONDS=3600

# --- Upstream ---
UPSTREAM_TIMEOUT_SECONDS=60

# --- Connector side only (not read by the server) ---
# `agentplane connect claude|codex|cursor|mcp|sdk` stores its Project API Key in
# ~/.agentplane/credentials.json (chmod 600). These env vars override that file
# on the developer's machine; they belong in a shell profile, not in the
# gateway's .env.
#   AGENTPLANE_URL=http://127.0.0.1:8000   # control-plane base URL
#   AGENTPLANE_API_KEY=ap_live_...         # Project API Key the connector reports with
#   AGENTPLANE_HOME=~/.agentplane          # credentials directory override
